// ─── CONFIGURACIÓN INICIAL ────────────────────────────────────────────
generator client {
  provider = "prisma-client-js"
}

// ✅ DESPUÉS 
datasource db {
  provider = "postgresql"
}

// ─── MODELO 1: USUARIO ────────────────────────────────────────────────
model Usuario {
  id                Int       @id @default(autoincrement())
  nombre            String    @db.VarChar(100)
  email             String    @unique @db.VarChar(255)
  password          String
  avatarUrl         String?
  rol               String    @default("cliente")
  activo            Boolean   @default(true)
  creadoEn          DateTime  @default(now()) @map("created_at")
  actualizadoEn     DateTime  @updatedAt @map("updated_at")
  codigoReferido    String?   @unique
  referidoPorId     Int?
  referidoPor       Usuario?  @relation("Referidos", fields: [referidoPorId], references: [id])
  referidos         Usuario[] @relation("Referidos")
  creditoDisponible Decimal   @default(0) @db.Decimal(10, 2)

  pedidos     Pedido[]
  direcciones Direccion[]
  mensajes    MensajeChat[]
  resenas     Resena[]

  @@map("usuarios")
}

// ─── MODELO 2: DIRECCION ──────────────────────────────────────────────
model Direccion {
  id             Int      @id @default(autoincrement())
  usuarioId      Int      @map("usuario_id")
  nombreDest     String   @map("nombre_dest") @db.VarChar(100)
  telefono       String?  @db.VarChar(20)
  departamento   String   @db.VarChar(80)
  ciudad         String   @db.VarChar(80)
  barrio         String?  @db.VarChar(100)
  direccion      String   @db.VarChar(255)
  predeterminada Boolean  @default(false)
  creadoEn       DateTime @default(now()) @map("created_at")

  usuario Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  pedidos Pedido[]

  @@map("direcciones")
}

// ─── MODELO 3: CATEGORIA ──────────────────────────────────────────────
model Categoria {
  id          Int     @id @default(autoincrement())
  nombre      String  @unique @db.VarChar(80)
  slug        String  @unique @db.VarChar(80)
  descripcion String?
  imagenUrl   String? @map("imagen_url")
  activa      Boolean @default(true)

  productos     Producto[]
  subcategorias Subcategoria[]

  @@map("categorias")
}

// ── MODELO 4: PRODUCTO ──────────
model Producto {
  id             Int      @id @default(autoincrement())
  categoriaId    Int      @map("categoria_id")
  subcategoriaId Int?     @map("subcategoria_id")
  nombre         String   @db.VarChar(200)
  slug           String   @unique @db.VarChar(200)
  descripcion    String?
  precio         Decimal  @db.Decimal(10, 2)
  precioAntes    Decimal? @map("precio_antes") @db.Decimal(10, 2)
  badge          String?  @db.VarChar(30)
  destacado      Boolean  @default(false)
  activo         Boolean  @default(true)
  creadoEn       DateTime @default(now()) @map("created_at")
  actualizadoEn  DateTime @updatedAt @map("updated_at")

  categoria    Categoria        @relation(fields: [categoriaId], references: [id])
  subcategoria Subcategoria?    @relation(fields: [subcategoriaId], references: [id])
  tallas       Talla[]
  imagenes     ImagenProducto[]
  inventario   Inventario[]
  detalles     DetallePedido[]
  resenas      Resena[]

  @@map("productos")
}

// ─── MODELO 5: TALLA ──────────────────────────────────────────────────
model Talla {
  id         Int    @id @default(autoincrement())
  productoId Int    @map("producto_id")
  nombre     String @db.VarChar(10)
  tipo       String @default("ropa") @db.VarChar(20)

  producto   Producto        @relation(fields: [productoId], references: [id], onDelete: Cascade)
  inventario Inventario[]
  detalles   DetallePedido[]

  @@map("tallas")
}

// ─── MODELO 6: INVENTARIO ─────────────────────────────────────────────
model Inventario {
  id         Int @id @default(autoincrement())
  productoId Int @map("producto_id")
  tallaId    Int @map("talla_id")
  cantidad   Int @default(0)

  producto Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  talla    Talla    @relation(fields: [tallaId], references: [id], onDelete: Cascade)

  @@unique([productoId, tallaId])
  @@map("inventario")
}

// ─── MODELO 7: IMAGEN PRODUCTO ────────────────────────────────────────
model ImagenProducto {
  id          Int     @id @default(autoincrement())
  productoId  Int     @map("producto_id")
  url         String
  altText     String? @map("alt_text") @db.VarChar(200)
  esPrincipal Boolean @default(false) @map("es_principal")
  orden       Int     @default(0)

  producto Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@map("imagenes_producto")
}

// ─── MODELO 8: CODIGO DESCUENTO ───────────────────────────────────────
model CodigoDescuento {
  id           Int       @id @default(autoincrement())
  codigo       String    @unique @db.VarChar(50)
  tipo         String    @default("porcentaje") @db.VarChar(20)
  valor        Decimal   @db.Decimal(10, 2)
  minimoCompra Decimal   @default(0) @map("minimo_compra") @db.Decimal(10, 2)
  usosMaximos  Int?      @map("usos_maximos")
  usosActuales Int       @default(0) @map("usos_actuales")
  activo       Boolean   @default(true)
  fechaInicio  DateTime? @map("fecha_inicio")
  fechaFin     DateTime? @map("fecha_fin")

  pedidos Pedido[]

  @@map("codigos_descuento")
}

// ─── MODELO 9: PEDIDO ─────────────────────────────────────────────────
model Pedido {
  id             Int      @id @default(autoincrement())
  usuarioId      Int      @map("usuario_id")
  direccionId    Int      @map("direccion_id")
  codigoDescId   Int?     @map("codigo_desc_id")
  subtotal       Decimal  @db.Decimal(10, 2)
  descuento      Decimal  @default(0) @db.Decimal(10, 2)
  costoEnvio     Decimal  @default(12.90) @map("costo_envio") @db.Decimal(10, 2)
  total          Decimal  @db.Decimal(10, 2)
  estado         String   @default("pendiente") @db.VarChar(30)
  metodoPago     String?  @map("metodo_pago") @db.VarChar(50)
  referenciaPago String?  @map("referencia_pago") @db.VarChar(255)
  notas          String?
  creadoEn       DateTime @default(now()) @map("created_at")
  actualizadoEn  DateTime @updatedAt @map("updated_at")

  usuario    Usuario          @relation(fields: [usuarioId], references: [id])
  direccion  Direccion        @relation(fields: [direccionId], references: [id])
  codigoDesc CodigoDescuento? @relation(fields: [codigoDescId], references: [id])
  detalles   DetallePedido[]

  @@map("pedidos")
}

// ─── MODELO 10: DETALLE PEDIDO ────────────────────────────────────────
model DetallePedido {
  id         Int     @id @default(autoincrement())
  pedidoId   Int     @map("pedido_id")
  productoId Int     @map("producto_id")
  tallaId    Int     @map("talla_id")
  cantidad   Int     @default(1)
  precioUnit Decimal @map("precio_unit") @db.Decimal(10, 2)
  subtotal   Decimal @db.Decimal(10, 2)

  pedido   Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  producto Producto @relation(fields: [productoId], references: [id])
  talla    Talla    @relation(fields: [tallaId], references: [id])

  @@map("detalle_pedido")
}

// ─── MODELO 11: MENSAJE CHAT ──────────────────────────────────────────
model MensajeChat {
  id         Int      @id @default(autoincrement())
  usuarioId  Int      @map("usuario_id")
  emisor     String   @default("cliente") @db.VarChar(20)
  mensaje    String
  leido      Boolean  @default(false)
  archivoUrl String?  @map("archivo_url")
  creadoEn   DateTime @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("mensajes_chat")
}

// ─── MODELO 12: RESENA ────────────────────────────────────────────────
model Resena {
  id           Int      @id @default(autoincrement())
  productoId   Int      @map("producto_id")
  usuarioId    Int      @map("usuario_id")
  calificacion Int
  comentario   String?
  aprobada     Boolean  @default(false)
  creadoEn     DateTime @default(now()) @map("created_at")

  producto Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  usuario  Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([productoId, usuarioId])
  @@map("resenas")
}

model Subcategoria {
  id          Int        @id @default(autoincrement())
  nombre      String
  slug        String     @unique
  categoriaId Int
  categoria   Categoria  @relation(fields: [categoriaId], references: [id])
  productos   Producto[]

  @@map("subcategorias")
}

model Suscriptor {
  id       Int      @id @default(autoincrement())
  email    String   @unique
  activo   Boolean  @default(true)
  creadoEn DateTime @default(now()) @map("created_at")

  @@map("suscriptores")
}
